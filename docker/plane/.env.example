# Copy to docker/plane/.env (gitignored) and set the two secrets below.
#   cp .env.example .env
#   sed -i "s/^SECRET_KEY=.*/SECRET_KEY=$(openssl rand -hex 32)/" .env
#   sed -i "s/^LIVE_SERVER_SECRET_KEY=.*/LIVE_SERVER_SECRET_KEY=$(openssl rand -hex 32)/" .env
# or just run: make plane-init

# --- Release ---
# `stable` tracks the latest Plane release; pin (e.g. v1.4.2) for reproducibility.
APP_RELEASE=v1.4.2

# --- Networking (loopback only by default; port 80 is often taken) ---
APP_DOMAIN=localhost
PLANE_HOST_BIND=127.0.0.1
LISTEN_HTTP_PORT=8180
LISTEN_HTTPS_PORT=8543
SITE_ADDRESS=:80
# Caddy ACME settings. CERT_ACME_CA must be non-empty or Caddy refuses to start.
# Only used if SITE_ADDRESS is a real domain (automatic HTTPS).
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
CERT_EMAIL=
CERT_ACME_DNS=
WEB_URL=http://localhost:8180
CORS_ALLOWED_ORIGINS=http://localhost:8180
API_BASE_URL=http://api:8000

# --- Secrets (REQUIRED: change before first start) ---
SECRET_KEY=change-this-key-on-deployment
LIVE_SERVER_SECRET_KEY=change-this-key-on-deployment

# --- Datastores (internal to the compose network) ---
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
PGDATABASE=plane
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane

# --- Object storage (bundled MinIO-compatible "silo") ---
USE_MINIO=1
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

# --- Misc ---
DEBUG=0
API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute
# Needed if you point Plane webhooks at private-network services:
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=
# DOCKER_PLATFORM=linux/amd64

# --- Optional SSO layer (LDAP -> Keycloak -> Plane). `make plane-sso-init` appends these
# with random secrets to your .env; they are shown here for reference only.
# LDAP_ADMIN_PASSWORD=
# KEYCLOAK_ADMIN_PASSWORD=
# KEYCLOAK_CLIENT_SECRET=
# KEYCLOAK_PUBLIC_URL=http://localhost:8280
# KEYCLOAK_PORT=8280
# SSO_SHIM_PORT=8181
# Login-button suffix rewritten by sso-edge ("Continue with SSO"). Not a Plane setting.
# PLANE_SSO_LOGIN_LABEL=SSO
