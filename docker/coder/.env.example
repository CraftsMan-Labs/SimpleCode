# Copy to .env with `make coder-init`. Do not commit .env.

# Pinned local-development images.
CODER_IMAGE=ghcr.io/coder/coder:v2.37.4
CODER_POSTGRES_IMAGE=postgres:17.6-alpine

# Same hostname and port work in the browser and from Docker networks because
# Compose assigns coder.localhost as an internal network alias.
CODER_ACCESS_URL=http://coder.localhost:7080
CODER_HOST_BIND=127.0.0.1
CODER_PORT=7080
CODER_DOCKER_GID=999

CODER_DB_USER=coder
CODER_DB_NAME=coder
CODER_DB_PASSWORD=generated-by-make-coder-init

# Generated by coder-init. Used only by compose.sso.yml and Keycloak setup.
CODER_OIDC_CLIENT_SECRET=generated-by-make-coder-init
CODER_KEYCLOAK_ISSUER=http://keycloak.localhost:8280/realms/plane
