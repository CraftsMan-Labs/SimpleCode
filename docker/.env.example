# Copy to docker/.env and adjust. All knobs are optional.

# --- Host port binds (loopback by default) ---
# HEADROOM_HOST_BIND=127.0.0.1
# HEADROOM_PORT=8787
# NINEROUTER_HOST_BIND=127.0.0.1
# NINEROUTER_PORT=20128

# --- Images ---
# HEADROOM_IMAGE=ghcr.io/headroomlabs-ai/headroom:latest
# NINEROUTER_IMAGE=decolua/9router:latest
# COCOINDEX_CODE_IMAGE=cocoindex/cocoindex-code:latest
# COCOINDEX_CODE_IMAGE=cocoindex/cocoindex-code:full

# --- Paths ---
# Persist 9Router config/providers (default: ~/.9router)
# NINEROUTER_DATA=/Users/you/.9router
# Projects cocoindex can see (default: $HOME)
# COCOINDEX_HOST_WORKSPACE=/Users/you/Desktop/projects

# --- Linux file ownership for cocoindex ---
# PUID=1000
# PGID=1000

# --- Headroom ---
# HEADROOM_MODE=cache
# HEADROOM_TELEMETRY=off
